---
/**
 * Official App Store and Google Play badges, served as same-origin SVG files
 * from public/images/badges/ (CSP `img-src 'self'` covers them).
 *
 * Both badge artworks fill their viewBox edge to edge with no built-in
 * padding, so matching the CSS height matches the visual height. Widths are
 * the true aspect ratios at that height and are declared explicitly so the
 * row doesn't reflow while the SVGs load:
 *   App Store   119.66 × 40    → 2.9916 : 1  → 132 × 44
 *   Google Play 239.17 × 70.87 → 3.3748 : 1  → 148 × 44
 */
export const APP_STORE_URL = 'https://apps.apple.com/us/app/practicing-presence/id1467007716';
export const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=com.zeek.practicingpresence';
---

<div class="badges">
  <a href={APP_STORE_URL} rel="noopener">
    <img
      src="/images/badges/app-store.svg"
      alt="Download Practicing Presence on the App Store"
      width="132"
      height="44"
    />
  </a>
  <a href={PLAY_STORE_URL} rel="noopener">
    <img
      src="/images/badges/google-play.svg"
      alt="Get Practicing Presence on Google Play"
      width="148"
      height="44"
    />
  </a>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .badges a {
    display: inline-block;
    line-height: 0;
    border-radius: 8px;
    transition: transform 120ms ease;
  }

  .badges a:hover {
    transform: translateY(-2px);
  }

  /* Height is the single source of truth; width follows the aspect ratio, so
     the two badges always sit on the same baseline at the same size. */
  .badges img {
    height: 44px;
    width: auto;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .badges a,
    .badges a:hover {
      transition: none;
      transform: none;
    }
  }
</style>
