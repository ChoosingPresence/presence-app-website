---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadges from '../components/StoreBadges.astro';
import DeviceFrame from '../components/DeviceFrame.astro';

import iphoneHome from '../assets/screens/iphone-home.jpg';
import iphoneMorning from '../assets/screens/iphone-morning-practice.jpg';
import iphoneQuestions from '../assets/screens/iphone-three-questions.jpg';
import iphoneBreaths from '../assets/screens/iphone-three-breaths.jpg';
import iphoneVideos from '../assets/screens/iphone-videos.jpg';
import iphoneInformation from '../assets/screens/iphone-information.jpg';
import ipadHome from '../assets/screens/ipad-home.jpg';
import pixelHome from '../assets/screens/pixel-home.jpg';

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Practicing Presence — A Christian Way',
  operatingSystem: 'iOS, iPadOS, Android',
  applicationCategory: 'HealthApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.6',
    ratingCount: '124',
    bestRating: '5',
  },
  author: { '@type': 'Organization', name: 'B:Drive Communications, LLC' },
  url: 'https://practicingpresence.app',
  installUrl: [
    'https://apps.apple.com/us/app/practicing-presence/id1467007716',
    'https://play.google.com/store/apps/details?id=com.zeek.practicingpresence',
  ],
});

const features = [
  {
    title: 'Morning Practice',
    body: 'A guided morning meditation of 15 or 20 minutes — or stay as long as you like. Gentle audio guidance and a hand-on-heart grounding technique to begin the day rooted in stillness.',
  },
  {
    title: 'Three Breaths (for presence)',
    body: 'Whenever unease or anxiety begins to build, take three conscious breaths with the intention of connecting with God’s spiritual energy. Practiced each hour from 8am to 8pm, it renews you throughout the day.',
  },
  {
    title: 'Three Questions (hourly renewal)',
    body: 'Three questions asked as you breathe — am I present now? how do I feel inside? do I have a sense of calm or peace within? — to gauge your spiritual progress and return to the power of the present moment.',
  },
  {
    title: 'Choosing Presence Videos',
    body: 'A library of Choosing Presence conversations built right into the app, including the conversation at Tamaya — for going deeper whenever you have the time.',
  },
  {
    title: 'Reminders on Your Schedule',
    body: 'Hourly invitations arrive between 8:00 am and 8:00 pm by default. Set whatever window fits your life, or turn reminders off entirely. The app adapts to your rhythm, not the other way around.',
  },
];

const screens = [
  { src: iphoneHome, alt: 'The Practicing Presence home screen, with Morning Practice, Three Questions and Three Breaths as overlapping circles' },
  { src: iphoneMorning, alt: 'The Morning Practice timer offering 15 minutes, 20 minutes or open-ended, above a line-drawn heart' },
  { src: iphoneBreaths, alt: 'The Three Breaths screen explaining how to take three conscious breaths each hour' },
  { src: iphoneQuestions, alt: 'The Three Questions screen listing the three questions asked while breathing' },
  { src: iphoneVideos, alt: 'The Choosing Presence Videos library inside the app, showing conversation films' },
  { src: iphoneInformation, alt: 'The Information screen with reminder start and end times set to 8:00 am and 8:00 pm' },
];
---

<BaseLayout
  title="Practicing Presence — A Christian Way | Free Christian Mindfulness App"
  description="Practicing Presence is a 100% free Christian mindfulness app. Pause, breathe, and rest in God's presence — no account, no ads, no in-app purchases. For iPhone, iPad and Android."
  path="/"
>
  <script type="application/ld+json" set:html={structuredData} is:inline />

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow"><span
          class="hero__eyebrow-name">Practicing Presence</span>&#32;<span
          class="hero__eyebrow-sep" aria-hidden="true">|</span>&#32;<span
          class="hero__eyebrow-tag">A Christian Way</span></p>
        <h1>Pause. Breathe. Rest in God&rsquo;s presence.</h1>
        <p class="hero__lead">
          A simple companion for contemplative Christian practice — a guided
          morning meditation, then three conscious breaths and three questions
          to return you to presence through the hours of the day.
        </p>
        <StoreBadges />
        <p class="rating">
          <span class="rating__stars" aria-hidden="true">★★★★★</span>
          <span><strong>4.6</strong> from 124 ratings on the App Store</span>
        </p>
        <p class="hero__trust">
          <strong>100% free.</strong> No account or sign-up. No ads. No in-app purchases.
        </p>
      </div>
      <div class="hero__phone">
        <DeviceFrame device="iphone" label="Practicing Presence running on iPhone" class="hero__device">
          <Image
            src={iphoneHome}
            alt="The Practicing Presence home screen, with Morning Practice, Three Questions and Three Breaths as overlapping circles"
            widths={[280, 560]}
            sizes="(max-width: 800px) 72vw, 280px"
            loading="eager"
            fetchpriority="high"
          />
        </DeviceFrame>
      </div>
    </div>
  </section>

  <!-- Truly free strip -->
  <section class="section section--tint" aria-labelledby="free-heading">
    <div class="container center">
      <h2 id="free-heading">Free means free</h2>
      <p class="section__lead lead-center">
        This app is a gift. It costs nothing, shows nothing, and asks for nothing.
      </p>
      <ul class="free-list">
        <li>No payment, ever</li>
        <li>No account or sign-up</li>
        <li>No advertisements</li>
        <li>No in-app purchases</li>
      </ul>
    </div>
  </section>

  <!-- Features -->
  <section class="section" aria-labelledby="features-heading">
    <div class="container">
      <h2 id="features-heading">A simple rhythm for the day</h2>
      <p class="section__lead">
        The app follows the Practice of Presence taught in the book&#32;
        <em>Choosing Presence</em>: begin in stillness, return often, reflect gently.
      </p>
      <div class="feature-grid">
        {
          features.map((f) => (
            <article class="card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Screenshots -->
  <section class="section section--deep" aria-labelledby="screens-heading">
    <div class="container">
      <h2 id="screens-heading" class="center">A glimpse inside</h2>
      <p class="section__lead lead-center screens-hint">
        Swipe to look around the app.
      </p>
    </div>
    <ul class="screen-rail" aria-label="Screenshots of the app">
      {
        screens.map((s) => (
          <li>
            <DeviceFrame device="iphone" label={s.alt} class="screen-rail__device">
              <Image
                src={s.src}
                alt={s.alt}
                widths={[240, 480]}
                sizes="(max-width: 720px) 62vw, 240px"
                loading="lazy"
              />
            </DeviceFrame>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Device family -->
  <section class="section" aria-labelledby="devices-heading">
    <div class="container">
      <h2 id="devices-heading" class="center">One practice, every screen</h2>
      <p class="section__lead lead-center">
        The same app on iPhone, iPad and Android — a real build for each, not a
        stretched phone layout.
      </p>
      <div class="device-strip">
        <div class="device-strip__item">
          <DeviceFrame device="ipad" label="Practicing Presence on iPad">
            <Image src={ipadHome} alt="The Practicing Presence home screen on an iPad, with the practice circles laid out across the wider display" widths={[380, 760]} sizes="(max-width: 760px) 80vw, 380px" loading="lazy" />
          </DeviceFrame>
          <p class="device-strip__label">iPad</p>
        </div>
        <div class="device-strip__item">
          <DeviceFrame device="iphone" label="Practicing Presence on iPhone">
            <Image src={iphoneHome} alt="The Practicing Presence home screen on an iPhone" widths={[190, 380]} sizes="(max-width: 760px) 42vw, 190px" loading="lazy" />
          </DeviceFrame>
          <p class="device-strip__label">iPhone</p>
        </div>
        <div class="device-strip__item">
          <DeviceFrame device="pixel" label="Practicing Presence on Android">
            <Image src={pixelHome} alt="The Practicing Presence home screen on a Pixel phone running Android" widths={[190, 380]} sizes="(max-width: 760px) 42vw, 190px" loading="lazy" />
          </DeviceFrame>
          <p class="device-strip__label">Android</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Choosing Presence roots -->
  <section class="section section--tint" aria-labelledby="roots-heading">
    <div class="container roots">
      <div class="roots__book">
        <img
          src="/images/choosing-presence-book.jpg"
          alt="Cover of the book Choosing Presence by Jim Heaney"
          width="370"
          height="600"
          loading="lazy"
        />
      </div>
      <div>
        <h2 id="roots-heading">Rooted in <em>Choosing Presence</em></h2>
        <p class="section__lead">
          Practicing Presence is the companion app to the Practice of Presence — a
          contemplative Christian path described in the book&#32;
          <em>Choosing Presence: How to Access God&rsquo;s Peace and Release Fear,
          Anxiety, and Stress</em> by Jim Heaney.
        </p>
        <p>
          To go deeper with the practice, we recommend reading the book and
          exploring the courses, videos, and retreats at Choosing Presence.
          All proceeds from the book go to charity.
        </p>
        <p class="roots__buttons">
          <a class="button button--primary" href="https://amzn.to/3Tdmv8V" rel="noopener">
            Get the Book
          </a>
          <a class="button button--ghost" href="https://www.choosingpresence.org" rel="noopener">
            Visit ChoosingPresence.org
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Tutorials teaser -->
  <section class="section" aria-labelledby="learn-heading">
    <div class="container center">
      <h2 id="learn-heading">New here? We&rsquo;ll walk you through it.</h2>
      <p class="section__lead lead-center">
        Short video tutorials show you how to install the app and make the most
        of each practice.
      </p>
      <a class="button button--primary" href="/tutorials/">Watch the Tutorials</a>
    </div>
  </section>

  <!-- Download CTA -->
  <section id="download" class="section section--deep" aria-labelledby="download-heading">
    <div class="container center download">
      <img
        src="/images/app-icon.png"
        alt=""
        width="88"
        height="88"
        loading="lazy"
        class="download__icon"
      />
      <h2 id="download-heading">Begin practicing presence today</h2>
      <p class="section__lead center-lead">
        Free on iPhone, iPad, and Android. No account needed — download and breathe.
      </p>
      <div class="download__badges">
        <StoreBadges />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: linear-gradient(160deg, var(--hero-grad-1) 0%, var(--hero-grad-2) 55%, var(--hero-grad-3) 100%);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  /* The app's full name as a lockup. The `&#32;` entities around the separator
     are deliberate: Astro collapses whitespace at line breaks next to inline
     tags, and without them the halves run together when copied and the browser
     has no legitimate place to break the line on narrow screens. */
  .hero__eyebrow {
    font-family: var(--font-display);
    font-weight: 600;
    /* Sized to survive the narrowest column it ever occupies — the two-column
       hero at ~810px viewport gives the copy side only ~405px. */
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .hero__eyebrow-name {
    font-weight: 700;
  }

  .hero__eyebrow-tag {
    opacity: 0.85;
  }

  /* Neither half may split internally — otherwise a narrow column strands a
     single word ("…CHRISTIAN / WAY") on its own line. If the line has to
     break, it breaks cleanly between the two halves. */
  .hero__eyebrow-name,
  .hero__eyebrow-tag {
    white-space: nowrap;
  }

  .hero__eyebrow-sep {
    /* Real spaces already sit either side; this just opens the gap a little. */
    margin-inline: 0.2em;
    opacity: 0.45;
    font-weight: 400;
  }

  /* On phones the full lockup lands about 2px over the container. Tightening
     the tracking a little buys ~15px, which keeps the divider rather than
     dropping it — 360px and 375px devices both hold one clean line. */
  @media (max-width: 560px) {
    .hero__eyebrow {
      letter-spacing: 0.05em;
    }
  }

  /* Below ~360px even that won't fit; drop the divider so the break falls
     between two whole phrases instead of leaving a trailing bar. */
  @media (max-width: 359px) {
    .hero__eyebrow-sep {
      display: none;
    }
  }

  .hero__lead {
    font-size: 1.2rem;
    color: var(--ink-muted);
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }

  .hero__trust {
    margin-top: 1.1rem;
    color: var(--heading);
  }

  .hero__phone {
    display: flex;
    justify-content: center;
  }

  /* :global — these class names land on DeviceFrame's own root element, which
     carries that component's scope hash rather than this page's. */
  .hero__phone :global(.hero__device) {
    width: min(280px, 72vw);
  }

  /* App Store rating */
  .rating {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.1rem 0 0;
    font-size: 0.98rem;
    color: var(--ink-muted);
  }

  .rating__stars {
    color: var(--star);
    letter-spacing: 0.06em;
    font-size: 1.05rem;
  }

  .rating strong {
    color: var(--heading);
  }

  /* Free list */
  .free-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  .free-list li {
    background: var(--surface-card);
    border: 2px solid var(--sage);
    color: var(--heading);
    font-family: var(--font-display);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
  }

  /* Features */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1.4rem;
    margin-top: 2rem;
  }

  /* Screenshot rail — scroll-snap carousel on every width */
  .screens-hint {
    margin-bottom: 0;
  }

  .screen-rail {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0 max((100vw - var(--max-width)) / 2 + 1.5rem, 1.5rem) 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.35) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .screen-rail li {
    flex: 0 0 auto;
    scroll-snap-align: center;
    line-height: 0;
  }

  .screen-rail li :global(.screen-rail__device) {
    --frame-scale: 0.8;
    width: min(240px, 62vw);
  }

  .screen-rail::-webkit-scrollbar {
    height: 6px;
  }

  .screen-rail::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 999px;
  }

  /* Device family strip */
  /* A single lineup at every width — the point of this section is the size
     relationship between the three, which a wrapped stack destroys. */
  .device-strip {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(0.9rem, 3vw, 3.25rem);
    margin-top: 2.5rem;
  }

  .device-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  .device-strip__item :global(.device--ipad) {
    width: clamp(140px, 38vw, 380px);
  }

  .device-strip__item :global(.device--iphone),
  .device-strip__item :global(.device--pixel) {
    --frame-scale: 0.72;
    width: clamp(72px, 19vw, 190px);
  }

  .device-strip__label {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Roots */
  .roots {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .roots__book img {
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }

  .roots__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  /* Download */
  .download__icon {
    margin: 0 auto 1rem;
    border-radius: 20px;
  }

  .center-lead,
  .lead-center {
    margin-inline: auto;
  }

  .download__badges {
    display: flex;
    justify-content: center;
    margin-top: 1.25rem;
  }

  @media (max-width: 800px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero__lead {
      margin-inline: auto;
    }

    .hero__copy :global(.badges) {
      justify-content: center;
    }

    .rating {
      justify-content: center;
    }

    .roots {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .roots__book {
      display: flex;
      justify-content: center;
    }

    .roots__buttons {
      justify-content: center;
    }
  }

  /* Bezels and radii are drawn in px, so they need scaling down alongside the
     device widths or small frames end up looking like thick-rimmed toys. */
  @media (max-width: 640px) {
    .device-strip__item :global(.device--ipad) {
      --frame-scale: 0.55;
    }

    .device-strip__item :global(.device--iphone),
    .device-strip__item :global(.device--pixel) {
      --frame-scale: 0.34;
    }

    .device-strip__label {
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }
  }
</style>
